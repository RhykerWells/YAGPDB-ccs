{{/*
		Made by ranger_4297 (765316548516380732)

	Trigger Type: `Message Component`
	Trigger: `\A(?i)iota_morphs`

	©️ RhykerWells 2020-Present
	GNU, GPLV3 License
	Repository: https://github.com/RhykerWells/YAGPDB-cc
*/}}

{{$factionDataEntry := dbGet 0 "FactionDataV2"}}
{{if not $factionDataEntry}}
	{{sendResponse nil (componentBuilder "text" "FactionData not set up, please modify and run `-setData`." "ephemeral" true)}}
	{{return}}
{{end}}
{{$db := $factionDataEntry.Value}}

{{if reFind `GetMorph` .StrippedID}}
	{{$x := sendResponseRetID nil (componentBuilder "text" "Loading..." "ephemeral" true)}}
	{{$targetMember := .Member}}
	{{$rblxName := reReplace $db.Settings.NicknameRegex $targetMember.Nick ""}}
	{{$memberRanks := cslice}}
	{{$targetRank := sdict}}
	{{range $db.AllRanks}}
		{{if in $targetMember.Roles .RoleID}}
			{{$memberRanks = $memberRanks.Append .}}
		{{end}}
	{{end}}
	{{if eq (len $memberRanks) 1}}
		{{$targetRank = (index $memberRanks 0)}}
		{{$morphContainer := execTemplate "getReturnMorphContainer" (sdict "TargetMember" $targetMember "RblxName" $rblxName "TargetRank" $targetRank "DB" $db)}}
		{{try}}
			{{sendTargetDM $targetMember.User.ID $morphContainer}}
			{{editResponse .Interaction.Token $x (componentBuilder "text" "Done! (Sent you a DM)" "ephemeral" true)}}
		{{catch}}
			{{editResponse .Interaction.Token $x (componentBuilder "text" "Was unable to send you a DM with your morph, please contact our Coordination Bureau" "ephemeral" true)}}
		{{end}}
	{{else}}
		{{$options := cslice}}
	{{range $memberRanks}}
		{{if (in $targetMember.Roles .RoleID)}}
			{{$division := $db.DivisionLookup.Get .Division}}
			{{$options = $options.Append (sdict
				"label" .Name
				"value" (printf "%d" .RoleID)
				"description" (printf "(%s)" $division.Name)
			)}}
		{{end}}
	{{end}}
	{{$menu := cmenu
		"type" "text"
		"placeholder" "Select which rank to retrieve the morph for"
		"custom_id" (printf "iota_morphsSelectMemberMorph-%d-true" $targetMember.User.ID)
		"options" $options
		"min_values" 1
		"max_values" 1
	}}
	{{$container := componentBuilder
		"container" (sdict
			"components" (componentBuilder
				"text" "# Retrieve Morph"
				"separator" true
				"text" "You have multiple eligible ranks. Please choose which one to retrieve the morph for."
				"menus" $menu
			)
		)
	}}
	{{editResponse .Interaction.Token $x $container}}
	{{deleteInteractionResponse .Interaction.Token $x}}
	{{end}}
{{end}}

{{if reFind `SelectMemberMorph` .StrippedID}}
	{{$x := sendResponseRetID nil (componentBuilder "text" "Loading..." "ephemeral" true)}}
	{{$memberID := reFind `\d+` .StrippedID}}
	{{$targetMember := getMember $memberID}}
	{{$rblxName := (reReplace $db.Settings.NicknameRegex $targetMember.Nick "")}}
	{{$memberRanks := cslice}}
	{{$targetRank := sdict}}
	{{range $db.AllRanks}}
		{{if in $targetMember.Roles .RoleID}}
			{{$memberRanks = $memberRanks.Append .}}
		{{end}}
	{{end}}
	{{$v := .Values}}
	{{range $memberRanks}}
		{{if eq .RoleID (index $v 0 | toInt)}}
			{{$targetRank = .}}
			{{break}}
		{{end}}
	{{end}}
	{{$morphContainer := execTemplate "getReturnMorphContainer" (sdict "TargetMember" $targetMember "RblxName" $rblxName "TargetRank" $targetRank "DB" $db)}}
	{{if not (reFind `true` .StrippedID)}}
		{{deleteInteractionResponse .Interaction.Token $x 0}}
		{{sendMessage nil $morphContainer}}
	{{else}}
		{{try}}
			{{sendTargetDM $targetMember.User.ID $morphContainer}}
			{{editResponse .Interaction.Token $x (componentBuilder "text" "Done! (Sent you a DM)" "ephemeral" true)}}
		{{catch}}
			{{editResponse .Interaction.Token $x (componentBuilder "text" "Was unable to send you a DM with your morph, please contact our Coordination Bureau" "ephemeral" true)}}
		{{end}}
	{{end}}
{{end}}

{{define "getReturnMorphContainer"}}
	{{$targetMember := getMember .TargetMember.User.ID}}
	{{$actualTargetRank := .TargetRank}}
	{{$divisionRanks := .DB.RanksByDivision.Get .TargetRank.Division}}
	{{if in (cslice 1536242563751616542 1536113330379427871 1536246816864206878 1536113429004292108) .TargetRank.RoleID}}
		{{range $divisionRanks}}
			{{$rankData := $.DB.RankLookup.Get .}}
			{{if and (in $targetMember.Roles $rankData.RoleID) (not (in (cslice 1536242563751616542 1536113330379427871 1536246816864206878 1536113429004292108) $rankData.RoleID))}}
				{{$actualTargetRank = $rankData}}
				{{break}}
			{{end}}
		{{end}}
	{{end}}
	{{$targetEchelon := .DB.EchelonLookup.Get .TargetRank.Echelon}}
	{{$morphData := .TargetRank.MorphData}}
	{{$morphKeys := sdict
		"permmorph" "Morph"
		"permshirt" "Shirt"
		"permpants" "Pants"
		"permhat" "Hats"
		"permrtag" "RTag"
		"permcrtag" "RTag"
		"startergear" "StarterGear"
		"permmaxhealth" "Health"
	}}
	{{$orderedKeys := cslice
		"permmorph"
		"permshirt"
		"permpants"
		"permhat"
		"permrtag"
		"permcrtag"
		"startergear"
		"permmaxhealth"
	}}
	{{$deployedAsTHH := in (cslice 1536242563751616542 1536113330379427871 ) $.TargetRank.RoleID}}
	{{$deployedAsVW := in (cslice 1536246816864206878 1536113429004292108 ) $.TargetRank.RoleID}}
	{{$health := $morphData.Health}}
	{{if $deployedAsTHH}}
		{{$health = 225}}
		{{if eq $actualTargetRank.Echelon "VG-C"}}
			{{$health = 250}}
		{{end}}
	{{else if $deployedAsVW}}
		{{$health = $actualTargetRank.MorphData.Health}}
	{{end}}
	{{$rTagText := $morphData.RTag.Text}}
	{{$rTagColour := $morphData.RTag.Colour}}

	{{if $deployedAsTHH}}
		{{$rTagText = printf "[Iota-4] | \"The Hidden Hand\" | %s <br/><font face=\"Merriweather\" color=\"#FF0000\">[Heavy Weapons Specialist]</font>" $actualTargetRank.Name}}
	{{else if $deployedAsVW}}
		{{$rTagText = printf "[Iota-4] | \"The Veilwatch\" | %s <br/><font face=\"Garamond\" color=\"#FF0000\">[Designated Marksman Unit]</font>" $actualTargetRank.Name}}
	{{end}}

	{{$morphParts := cslice}}
	{{range $_, $key := $orderedKeys}}
		{{$dataKey := $morphKeys.Get $key}}
		{{$value := $morphData.Get $dataKey}}

		{{if eq $key "permrtag"}}
			{{$value = $rTagText}}
		{{else if eq $key "permcrtag"}}
			{{$value = $rTagColour}}
		{{else if eq $key "permmaxhealth"}}
			{{$value = $health}}
		{{end}}

		{{if $value}}
			{{$morphParts = $morphParts.Append (printf "%s %s %v" $key $.RblxName $value)}}
		{{end}}
	{{end}}
	{{$fullMorphViaRun := print "run " (joinStr " & " $morphParts)}}
	{{$morphContainer := (componentBuilder
		"allowed_mentions" (sdict
			"parse" (cslice)
		)
		"container" (sdict
			"color" 0x3D1585
			"components" (componentBuilder
				"text" (printf "# Iota-4 Veilrunners Morph\n>>> **User:** @%s (%s)\n**Rank:** %s (%s)\n**Division:** %s\n**Echelon:** %s" .RblxName $targetMember.User.Mention $actualTargetRank.Name .TargetRank.Name .TargetRank.Division $targetEchelon.Name)
				"separator" true
				"text" (printf "**Morph Type:** `%s`\n**Hats:** `%s`\n**Shirt:** `%d`\n**Pants:** `%d`\n**Health:** `%v`\n**Starter Gear:** `%s`\n\n**RTag:** `%s`\n**RTag Colour:** `%s`" $morphData.Morph $morphData.Hats $morphData.Shirt $morphData.Pants $health $morphData.StarterGear $rTagText $rTagColour)
				"separator" true
				"text" (printf "```%s```" $fullMorphViaRun)
			)
		)
	)}}
	{{return $morphContainer}}
{{end}}