{{/*
		Made by ranger_4297 (765316548516380732)

	Trigger Type: `Message Component`
	Trigger: `\A(?i)iota_dossier`

	Defer: None

	©️ RhykerWells 2020-Present
	GNU, GPLV3 License
	Repository: https://github.com/RhykerWells/YAGPDB-ccs/
*/}}

{{$factionData := dbGet 0 "FactionDataV2"}}
{{if not $factionData}}
	{{sendResponse nil (componentBuilder "text" "FactionData not set up, please modify and run `-setData`" "ephemeral" true)}}
	{{return}}
{{end}}
{{$factionData = $factionData.Value}}

{{$divisions := $factionData.Divisions}}

{{$selectedShortName := index .Values 0}}
{{$selectedDivision := ""}}

{{range $division := $divisions}}
	{{if eq $division.ShortName $selectedShortName}}
		{{$selectedDivision = $division}}
	{{end}}
{{end}}

{{if not $selectedDivision}}
	{{sendResponse nil (componentBuilder "text" "Invalid division selected." "ephemeral" true)}}
	{{return}}
{{end}}

{{$options := cslice}}
{{range $division := $divisions}}
    {{$options = $options.Append (sdict
        "label" $division.Name
        "value" $division.ShortName
        "description" (printf "View %s personnel" $division.ShortName)
        "default" (eq $division.ShortName $selectedDivision.ShortName)
    )}}
{{end}}
{{$menu := cmenu
    "type" "text"
    "custom_id" "iota_dossierSelectDivision"
    "placeholder" "Select a division..."
    "options" $options
    "min_values" 1
    "max_values" 1
}}

{{$description := ""}}

{{range $echelon := $selectedDivision.Echelons}}
    {{$description = printf "%s\n**<@&%v>**\n" $description $echelon.RoleID}}
    {{range $rank := $echelon.Ranks}}
		{{$roleID := (or $rank.DisplayID $rank.RoleID)}}
        {{$description = printf "%s- <@&%d>\n" $description $roleID}}
    {{end}}
{{end}}

{{$description = printf "%s\n-# Click the roles to view their personnel." $description}}
{{$embed := sdict
    "title" (printf "Task Force Iota-4 | Personnel Dossier -- %s" $selectedDivision.Name)
    "description" $description
    "color" 0x3D1585
}}

{{$message := complexMessage
    "embed" (cslice $embed)
    "menus" $menu
}}

{{updateMessage $message}}