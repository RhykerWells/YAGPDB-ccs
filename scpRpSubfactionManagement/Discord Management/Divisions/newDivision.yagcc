{{/*
		Made by ranger_4297 (765316548516380732)

	Trigger Type: `Regex`
	Trigger: `createDivision`

	©️ RhykerWells 2020-Present
	GNU, GPLV3 License
	Repository: https://github.com/RhykerWells/YAGPDB-ccs/
*/}}

{{$domain := "records.iota-4.org"}}

{{$trigger := print `\A(?i)(?:\` .ServerPrefix `|<@!?` .BotUser.ID `>\*)(` .CCTrigger `)`}}
{{if not (reFind $trigger .Message.Content)}}
	{{return}}
{{end}}

{{$settings := or (dbGet 0 "managementSettings").Value sdict}}
{{$color := or $settings.Colour 0x231068}}
{{if not .ExecData}}
	{{with .CmdArgs}}
		{{if eq (index . 0 ) "regen-info"}}
			{{if not (gt (len .) 1)}}
				{{sendMessage nil (printf "Missing required arguments.\n\n```regen-info <Division>```")}}
				{{return}}
			{{end}}
			{{$divisionArg := (index . 1)}}
			{{$division := (dbGet 0 $divisionArg).Value}}
			{{if not $division}}
				{{sendMessage nil (printf "Could not find division")}}
				{{return}}
			{{end}}
			{{$cleaned := reReplace `[✪─]+` $division.E3.Name "" | trimSpace | title}}
			{{$parts := split $cleaned " "}}
			{{$E3Delim := printf "%s-%s" (index $parts 0) (index (split (index $parts 1) "") 0)}}
			{{$rulesEmbed := cembed
				"title" (printf "Task Force Iota-4 | %s Rules & Procedures" $division.Name)
				"description" (printf "# Rules\nThe %s within Iota-4 follows the same standards and regulations as [Site 416](https://discord.com/channels/1331497708380225566/1331505776262512670/1351378908225994824), as well as our our [SOP](https://%s/en/Divisions/Core/SOP).\nIn addition to these, the %[1]s also follows the [%[3]s SOP](https://%[2]s/en/Divisions/%[3]s/SOP).\n-# Division based SOP superseeds the core SOP." $division.Name $domain $division.Designation)
				"color" $color
			}}
			{{$informationEmbed := cembed
				"title" (printf "Task Force Iota-4 | %s Information" $division.Name)
				"description" (printf "# What is the %s?\n%s\n\n# Leadership team\n### Veil Command (`VC`)\n- <@&1375377194330755113>\n- <@&1375377873241772095>\n### Coordination Bureau (`CB`)\n- <@&1375377969492787220>\n- <@&1375378044767834133>\n- <@&1461894600422850714>\n### %s (`%s`)\n- <@&%d>\n- <@&%d>" $division.Name $division.Purpose $division.E3.Name (upper $E3Delim) $division.HR1.ID $division.HR2.ID)
				"color" $color
			}}
			{{$informationContEmbed := sdict
				"title" (printf "Task Force Iota-4 | %s Information: Continued" $division.Name)
				"description" (printf "# Other important information\nOur official documents follow specific versioning.\nThe version is as follows: `EDITION.FEATURE.PATCH`\n- `EDITION` | New version, e.g. Document rewrites.\n- `FEATURE` | New document sections.\n- `PATCH` | Non structural tweaks, e.g. spelling & grammar.\nWe will always update you on `EDITION` and `FEATURE` changes.\n\n# Links & queries\n- Site 416 | [Communications server](<https://discord.com/site416>), [Rules & Guidelines](<https://discord.com/channels/1331497708380225566/1331505776262512670>), [Manual Of Operations](<https://docs.google.com/document/d/1dCULOisRiiLRYojTmC4DEQjWBco9M7bLhWZhQuFfgP0/edit?usp=sharing>)\n\n - [Iota-4 | Communications server](<https://join.iota-4.org>)\n- [Iota-4 | Core SOP](<https://%s/en/Divisions/Core/SOP>)\n- [Iota-4 | Core Codex](<https://%[1]s/en/Divisions/Core/Codex>)\n\n- [Iota-4 | %[2]s SOP](<https://%[1]s/en/Divisions/%[3]s/SOP>)\n- [Iota-4 | %[2]s Codex](<https://%[1]s/en/Divisions/%[3]s/Codex>)\n- [Iota-4 | %[2]s Morph Document](<https://%[1]s.com/en/Divisions/%[3]s/Morphs>)\n\n- [Iota-4 | ROBLOX GROUP](<https://www.roblox.com/communities/36098297/Task-Force-Iota-4-Veil-Runners#!/about>)\n\nIf you require any other help UNRELATED TO `EU`/`MC` issues, please direct then to our <#1375374104764354580> channel, otherwise, please direct them to your designated channel." $domain $division.Name $division.Designation)
				"color" $color
			}}
			{{editMessage $division.Links.InfoCID  $division.Links.InfoMID (complexMessageEdit "content" "" "embed" (cslice $rulesEmbed $informationEmbed $informationContEmbed))}}
			{{sendMessage nil "Done!"}}
		{{end}}
		{{return}}
	{{end}}
	{{$components := cslice 
		(cbutton "label" "Add new subdivision" "custom_id" "iota_discordAddSubdivisionStart" "style" "success")
	}}
	{{if dbGet 0 "TempDivision"}}
		{{sendMessage "There is currently one (1) guild waiting for it's channels to be created"}}
		{{return}}
	{{end}}
    {{$x := sendMessageRetID nil (complexMessage "content" "Add new subdivision?" "components" $components)}}
	{{dbSet 0 "NewDivision" sdict}}
    {{scheduleUniqueCC .CCID nil 20 $x (sdict "Channel" .Channel "ID" $x)}}
	{{return}}
{{end}}
{{$components := cslice 
	(cbutton "label" "Add new subdivision" "custom_id" "iota_iota_discordAddSubdivisionStart" "style" "success" "disabled" true)
}}
{{editMessage nil .ExecData.ID (complexMessageEdit "content" "Add new subdivision?\n\n-# This command has expired." "components" $components)}}