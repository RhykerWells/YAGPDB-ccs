{{$data := cslice
	$core
	$VG
	$COTV
	$IOD
}}

{{/* DO NOT EDIT BELOW */}}

{{$fullData := cslice}}

{{$rankLookup := sdict}}
{{$divisionLookup := sdict}}
{{$echelonLookup := sdict}}

{{$allRanks := cslice}}
{{$divisionRankLookup := sdict}}
{{$echelonRankLookup := sdict}}

{{$morphOverrides := cslice}}

{{range $division := $data}}

	{{$divisionEchelons := sdict}}
	{{$divisionRanks := cslice}}


	{{/* Division morph override tracking */}}
	{{with $division.MorphData}}

		{{range $k,$v := .}}

			{{if eq $k "StarterGear"}}

				{{$old := $division.MorphData.Get "StarterGear"}}

				{{if $old}}
					{{$division.MorphData.Set "StarterGear" (joinStr "," $old $v)}}
				{{else}}
					{{$division.MorphData.Set "StarterGear" $v}}
				{{end}}

			{{end}}

		{{end}}

		{{$morphOverrides = $morphOverrides.Append (sdict
			"Type" "Division"
			"Name" $division.ShortName
			"MorphData" $division.MorphData
		)}}

	{{end}}

	{{range $echelon := $division.Echelons}}

		{{$echelonMorph := sdict}}
		{{$echelonRanks := cslice}}

		{{/* Inherit division morph */}}
		{{with $division.MorphData}}
			{{range $k,$v := .}}
				{{$echelonMorph.Set $k $v}}
			{{end}}
		{{end}}

		{{/* Echelon morph override tracking */}}
		{{with $echelon.MorphData}}
			{{range $k,$v := .}}

				{{if eq $k "StarterGear"}}
					{{$old := $echelonMorph.Get "StarterGear"}}

					{{if $old}}
						{{$echelonMorph.Set "StarterGear" (joinStr "," $old $v)}}
					{{else}}
						{{$echelonMorph.Set "StarterGear" $v}}
					{{end}}

				{{else}}

					{{$echelonMorph.Set $k $v}}

				{{end}}

			{{end}}

			{{$morphOverrides = $morphOverrides.Append (sdict
				"Type" "Echelon"
				"Name" $echelon.ShortName
				"Division" $division.ShortName
				"MorphData" .
			)}}
		{{end}}

		{{range $rank := $echelon.Ranks}}

			{{$finalMorph := sdict}}

			{{/* Copy inherited morph */}}
			{{range $k,$v := $echelonMorph}}
				{{$finalMorph.Set $k $v}}
			{{end}}

			{{/* Rank overrides */}}
			{{with $rank.MorphData}}

				{{$morphOverrides = $morphOverrides.Append (sdict
					"Type" "Rank"
					"Name" $rank.ShortName
					"Division" $division.ShortName
					"Echelon" $echelon.ShortName
					"MorphData" .
				)}}

				{{range $k,$v := .}}

					{{if eq $k "StarterGear"}}
						{{$old := $finalMorph.Get "StarterGear"}}

						{{if $old}}
							{{$finalMorph.Set "StarterGear" (joinStr "," $old $v)}}
						{{else}}
							{{$finalMorph.Set "StarterGear" $v}}
						{{end}}

					{{else}}

						{{$finalMorph.Set $k $v}}

					{{end}}

				{{end}}

			{{end}}

			{{$rankData := sdict
				"Name" $rank.Name
				"ShortName" $rank.ShortName
				"RoleID" $rank.RoleID
				"Division" $division.ShortName
				"Echelon" $echelon.ShortName
				"MorphData" $finalMorph
			}}

			{{/* Rank lookup */}}
			{{$rankLookup.Set $rank.ShortName $rankData}}

			{{/* All ranks */}}
			{{$allRanks = $allRanks.Append $rankData}}

			{{/* Division rank ordering */}}
			{{$divisionRanks = $divisionRanks.Append $rank.ShortName}}

			{{/* Echelon rank ordering */}}
			{{$echelonRanks = $echelonRanks.Append $rank.ShortName}}

		{{end}}

		{{/* Echelon lookup */}}
		{{$echelonLookup.Set $echelon.ShortName (sdict
			"Name" $echelon.Name
			"ShortName" $echelon.ShortName
			"RoleID" $echelon.RoleID
			"Division" $division.ShortName
			"Ranks" $echelonRanks
			"HasMorphOverride" $echelon.MorphData
		)}}

		{{/* Echelon rank lookup */}}
		{{$echelonRankLookup.Set $echelon.ShortName $echelonRanks}}

		{{/* Store echelon inside division */}}
		{{$divisionEchelons.Set $echelon.ShortName (sdict
			"Name" $echelon.Name
			"Ranks" $echelonRanks
		)}}

	{{end}}

	{{/* Division rank lookup */}}
	{{$divisionRankLookup.Set $division.ShortName $divisionRanks}}

	{{/* Division lookup */}}
	{{$divisionLookup.Set $division.ShortName (sdict
		"Name" $division.Name
		"ShortName" $division.ShortName
		"RoleID" $division.RoleID
		"Echelons" $divisionEchelons
		"HasMorphOverride" $division.MorphData
	)}}

	{{$fullData = $fullData.Append $division}}
{{end}}


{{dbSet 0 "FactionDataV2"
	(sdict

		"Settings" $baseData

		"BaseMorphData" $baseMorphData

		"Divisions" $fullData

		"RankLookup" $rankLookup

		"DivisionLookup" $divisionLookup

		"EchelonLookup" $echelonLookup

		"AllRanks" $allRanks

		"RanksByDivision" $divisionRankLookup

		"RanksByEchelon" $echelonRankLookup

		"MorphOverrides" $morphOverrides
	)
}}

{{sendMessage nil "Done!"}}