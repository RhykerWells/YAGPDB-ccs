{{/*
Made by ranger_4297 (765316548516380732)

Trigger Type: `Modal`
Trigger: `\A(?i)iota_training`

©️ RhykerWells 2020-Present
GNU, GPLV3 License
Repository: https://github.com/RhykerWells/YAGPDB-ccs/
*/}}

{{$factionData := dbGet 0 "FactionDataV2"}}
{{if not $factionData}}
	{{sendResponse nil "FactionData not set up, please modify and run `-setData`"}}
	{{return}}
{{end}}

{{$trainingID := reReplace `[A-z]+-` .StrippedID "" | toInt}}
{{$entry := dbGet $trainingID "trainingData"}}
{{$db := $entry.Value}}
{{if not $db}}
	{{sendResponse nil "Something went wrong"}}
	{{return}}
{{end}}

{{if reFind `Outcome` .StrippedID}}
	{{$x := sendResponseRetID nil (componentBuilder "text" "Loading..." "ephemeral" true)}}
    {{if reFind `Attendees` .StrippedID}}
		{{with .ModalValues}}
			{{$attended := cslice}}
			{{range .confirmedUsersDropdown.value}}
				{{$attended = $attended.Append (toInt .)}}
			{{end}}
			{{$db.Set "Attended" $attended}}
		{{end}}
	{{else if reFind `Passed` .StrippedID}}
		{{with .ModalValues}}
			{{$passed := cslice}}
			{{range .confirmedUsersDropdown.value}}
				{{$passed = $passed.Append (toInt .)}}
			{{end}}
			{{$db.Set "Passed" $passed}}
		{{end}}
    {{else if reFind `Proof` .StrippedID}}
		{{range $_, $v := .InteractionData.Resolved.Attachments}}
			{{$url := reReplace "\u0026" $v.URL "&"}}
			{{$db.Set "Proof" $url}}
			{{break}}
		{{end}}
    {{end}}
	{{dbSetExpire $db.ID "trainingData" $db (toInt (($entry.ExpiresAt.Sub currentTime).Seconds))}}
	{{editResponse .Interaction.Token $x (componentBuilder "text" "Done!" "ephemeral" true)}}
	{{deleteInteractionResponse .Interaction.Token $x}}
{{end}}

{{if reFind `SubmitLog` .StrippedID}}
	{{$x := sendResponseRetID nil (componentBuilder "text" "Loading..." "ephemeral" true)}}
	{{$confidence := sdict "Short" .ModalValues.trainingConfidenceInput.value}}
	{{if eq $confidence.Short "Very Confident"}}
		{{$confidence.Set "Long" "I could confidently perform this role."}}
	{{else if eq $confidence.Short "Confident"}}
		{{$confidence.Set "Long" "I'm comfortable, but could use more practice."}}
	{{else if eq $confidence.Short "Somewhat Confident"}}
		{{$confidence.Set "Long" "I understand the basics but need guidance."}}
	{{else if eq $confidence.Short "Need More Practice"}}
		{{$confidence.Set "Long" "I don't yet feel ready."}}
	{{end}}
	{{$trainingLog := sdict
		"ID" 0
		"MsgID" 0
		"User" (sdict "ID" .User.ID "RobloxName" (reReplace $factionData.Value.Settings.NicknameRegex .Member.Nick ""))
		"Host" (sdict "ID" $db.Host.User.ID "RobloxName" (reReplace $factionData.Value.Settings.NicknameRegex $db.Host.Nick ""))
		"Type" $db.Rank.RoleID
		"Approval" ""
		"Confidence" $confidence
		"Feedback" (or "None" .ModalValues.trainingFeedbackInput.value)
		"Proof" $db.Proof
	}}
	{{if and (in $db.Attended .User.ID) (not (in $db.Passed .User.ID))}}
		{{editResponse .Interaction.Token $x (componentBuilder "text" "You did not pass this training." "ephemeral" true)}}
		{{deleteInteractionResponse .Interaction.Token $x}}
		{{return}}
	{{end}}
	{{$needsApproval := not (in $db.Attended .User.ID)}}
	{{if $needsApproval}}
		{{$trainingLog.Set "Approval" "Pending"}}
		{{$pendingContainer := (componentBuilder
			"allowed_mentions" (sdict "users" cslice)
			"container" (sdict
				"color" 0xFFAA00
				"components" (componentBuilder
					"text" "# Pending Training Log"
					"separator" true
					"text" (printf "> **User**: @%s (<@%d>)\n> **Training Rank**: <@&%d>\n> **Training Host**: @%s <@%d>\n> **Self-Confidence**: %s. (%s)\n> **Trainer Feedback**: %s" $trainingLog.User.RobloxName $trainingLog.User.ID $trainingLog.Type $trainingLog.Host.RobloxName $trainingLog.Host.ID $trainingLog.Confidence.Short $trainingLog.Confidence.Long $trainingLog.Feedback)
					"separator" false
					"gallery" (cslice
						(sdict "media" (or $db.Proof "https://iota-4.org/missingProof.png"))
					)
					"text" "-# If the proof image is unavailable, deny the submission and ask the attendee to resubmit with valid proof."
					"separator" false
					"buttons" (cslice
						(cbutton "label" "Approve" "custom_id" (printf "iota_trainingPendingApprove-%d-%d" $trainingLog.User.ID $trainingLog.Type) "style" "success")
						(cbutton "label" "Deny" "custom_id" (printf "iota_trainingPendingDeny-%d-%d" $trainingLog.User.ID $trainingLog.Type) "style" "danger")
					)
				)
			)
		)}}
		{{sendMessage 1532502218341748856 $pendingContainer}}
		{{editResponse .Interaction.Token $x (componentBuilder "text" "Your log has been submitted for approval." "ephemeral" true)}}
	{{else}}
		{{$trainingLog.Set "Approval" "Approved"}}
		{{$logID := dbIncr 0 "NewTlog" 1 | toInt}}
		{{$trainingLog.Set "ID" $logID}}
		{{$trainingLog.Set "Session" $db.ID}}
		{{$threads := (dbGet 0 "trainingLogThreads").Value}}
		{{if not $threads}}
			{{$threads = sdict}}
		{{end}}
		{{$logChannel := $threads.Get $trainingLog.User.RobloxName}}
		{{if $logChannel}}
			{{openThread (toInt $logChannel)}}
		{{else}}
			{{try}}
				{{$logChannel = (createForumPost 1534322694302990406 $trainingLog.User.RobloxName (printf "%s's training log" .User.Mention)).ID}}
			{{catch}}
				{{sendMessage nil (complexMessage "ephemeral" true "content" "Was not able to create a forum post channel for training log. Your log has not been saved.")}}
				{{return}}
			{{end}}
			{{$threads.Set $trainingLog.User.RobloxName $logChannel}}
			{{dbSet 0 "trainingLogThreads" $threads}}
		{{end}}
		{{$logContainer := (componentBuilder
			"allowed_mentions" (sdict "users" cslice)
			"container" (sdict
				"color" $db.Role.Color
				"components" (componentBuilder
					"text" (printf "# Training Log #%d" $trainingLog.ID)
					"separator" true
					"text" (printf "> **User**: @%s (<@%d>)\n> **Training Rank**: <@&%d>\n> **Training Host**: @%s <@%d>\n> **Self-Confidence**: %s. (%s)\n> **Trainer Feedback**: %s" $trainingLog.User.RobloxName $trainingLog.User.ID $trainingLog.Type $trainingLog.Host.RobloxName $trainingLog.Host.ID $trainingLog.Confidence.Short $trainingLog.Confidence.Long $trainingLog.Feedback)
					"separator" false
					"gallery" (cslice
						(sdict "media" (or $trainingLog.Proof "https://iota-4.org/missingProof.png"))
					)
				)
			)
		)}}
		{{$tLogID := sendMessageRetID $logChannel $logContainer}}
		{{$trainingLog.Set "MsgID" $tLogID}}
		{{editResponse .Interaction.Token $x (componentBuilder "text" "Done!" "ephemeral" true)}}
	{{end}}
	{{dbSet $trainingLog.User.ID (printf "trainingLog:%d" $trainingLog.Type) $trainingLog}}
	{{deleteInteractionResponse .Interaction.Token $x}}
{{end}}