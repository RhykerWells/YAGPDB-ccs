{{/*
		Made by ranger_4297 (765316548516380732)

	Trigger Type: `Message Component`
	Trigger: `\A(?i)iota_training`

	Defer: Ephemeral Message Response

	©️ RhykerWells 2020-Present
	GNU, GPLV3 License
	Repository: https://github.com/RhykerWells/YAGPDB-ccs/
*/}}

{{$factionData := dbGet 0 "FactionDataV2"}}
{{if not $factionData}}
	{{sendResponse nil (componentBuilder "text" "FactionData not set up, please modify and run `-setData`" "ephemeral" true)}}
	{{return}}
{{end}}

{{$targetMember := .Member}}

{{with .ExecData}}
    {{$db := (dbGet (toInt .Notice) "trainingData").Value}}
    {{if not $db}}
        {{return}}
    {{end}}
    {{$closedContainer := componentBuilder
        "container" (sdict
            "color" $db.Role.Color
            "components" (componentBuilder
                "section" (sdict
                    "text" (printf "# %s Training Completed" $db.Rank.Name)
                    "button" (cbutton
                        "label" "Training Log Closed"
                        "custom_id" "training_log_closed"
                        "style" "secondary"
                        "disabled" true
                    )
                )
                "separator" true
                "text" (printf "> **Host**: @%s <@%d>\n\nThe training log submission period has ended." (reReplace $factionData.Value.Settings.NicknameRegex $db.Host.Nick "") $db.Host.User.ID)
            )
        )
    }}
    {{editMessage 1532346844712272003 $db.TrainingMsg $closedContainer}}
    {{return}}
{{end}}

{{/* Pending log management */}}
{{if reFind `Pending` .StrippedID}}
	{{$x := sendResponseRetID nil (componentBuilder "text" "Loading... " "ephemeral" true)}}
	{{$IDMatches := reFindAllSubmatches `\d+` .StrippedID}}
	{{$logData := sdict
		"User" (sdict "ID" (index (index $IDMatches 0) 0 | toInt))
		"Type" (index (index $IDMatches 1) 0 | toInt)
	}}
	{{$db := dbGet $logData.User.ID (printf "trainingLog:%d" $logData.Type)}}
	{{if not $db}}
		{{editResponse .InteractionToken $x (componentBuilder "text" (printf "This log doesn't exist."))}}
		{{deleteInteractionResponse .Interaction.Token $x}}
		{{return}}
	{{end}}
	{{$db = $db.Value}}
	{{$type := ""}}
	{{$color := ""}}
	{{if reFind `Approve` .StrippedID}}
		{{$type = "Approved"}}
		{{$color = 0x00ff7b}}
		{{$db.Set "Approval" $type}}
		{{$logID := dbIncr 0 "NewTlog" 1 | toInt}}
		{{$db.Set "ID" $logID}}
		{{$threads := (dbGet 0 "trainingLogThreads").Value}}
		{{if not $threads}}
			{{$threads = sdict}}
		{{end}}
		{{$logChannel := $threads.Get $db.User.RobloxName}}
		{{if $logChannel}}
			{{openThread (toInt $logChannel)}}
		{{else}}
			{{try}}
				{{$logChannel = (createForumPost 1534322694302990406 $db.User.RobloxName (printf "%s's training log" .User.Mention)).ID}}
			{{catch}}
				{{editResponse .InteractionToken $x (componentBuilder "text" "Was not able to create a forum post channel for the training log. Your log has not been saved: %s" .Error)}}
				{{deleteInteractionResponse .Interaction.Token $x}}
				{{return}}
			{{end}}
			{{$threads.Set $db.User.RobloxName $logChannel}}
			{{dbSet 0 "trainingLogThreads" $threads}}
		{{end}}
		{{$logRank := getRoleID $db.Type}}
		{{$logContainer := (componentBuilder
			"allowed_mentions" (sdict "users" cslice)
			"container" (sdict
				"color" $logRank.Color
				"components" (componentBuilder
					"text" (printf "# Training Log #%d" $db.ID)
					"separator" true
					"text" (printf "> **User**: @%s (<@%d>)\n> **Training Rank**: <@&%d>\n> **Training Host**: @%s <@%d>\n> **Self-Confidence**: %s. (%s)\n> **Trainer Feedback**: %s" $db.User.RobloxName $db.User.ID $db.Type $db.Host.RobloxName $db.Host.ID $db.Confidence.Short $db.Confidence.Long $db.Feedback)
					"separator" false
					"gallery" (cslice
						(sdict "media" (or $db.Proof "https://iota-4.org/missingProof.png"))
					)
				)
			)
		)}}
		{{$tLogID := sendMessageRetID $logChannel $logContainer}}
		{{$db.Set "MsgID" $tLogID}}
		{{dbSet $db.User.ID (printf "trainingLog:%d" $db.Type) $db}}
	{{else}}
		{{$type = "Denied"}}
		{{$color = 0xFF0000}}
		{{dbDel $db.User.ID (printf "trainingLog:%d" $db.Type)}}
	{{end}}
	{{$pendingContainer := (componentBuilder
		"allowed_mentions" (sdict "users" cslice)
		"container" (sdict
			"color" $color
			"components" (componentBuilder
				"text" "# Pending Training Log"
				"separator" true
				"text" (printf "> **User**: @%s (<@%d>)\n> **Training Rank**: <@&%d>\n> **Training Host**: @%s <@%d>\n> **Self-Confidence**: %s. (%s)\n> **Trainer Feedback**: %s" $db.User.RobloxName $db.User.ID $db.Type $db.Host.RobloxName $db.Host.ID $db.Confidence.Short $db.Confidence.Long $db.Feedback)
				"separator" false
				"gallery" (cslice
					(sdict "media" (or $db.Proof "https://iota-4.org/missingProof.png"))
				)
				"separator" false
				"text" (printf "%s by @%s (%s)" $type (reReplace $factionData.Value.Settings.NicknameRegex .Member.Nick "") .User.Mention)
			)
		)
	)}}
	{{editMessage .Channel.ID .Message.ID $pendingContainer}}
	{{editResponse .InteractionToken $x (componentBuilder "text" "Done!")}}
	{{deleteInteractionResponse .Interaction.Token $x}}
	{{return}}
{{end}}

{{$trainingID := reReplace `[A-z]+-` .StrippedID "" | toInt}}
{{$entry := (dbGet $trainingID "trainingData")}}
{{$db := $entry.Value}}
{{if not $db}}
	{{sendResponse nil (componentBuilder "text" "Something went wrong" "ephemeral" true)}}
	{{return}}
{{end}}

{{if reFind `Join` .StrippedID}}
	{{$x := sendResponseRetID nil (componentBuilder "text" "Loading... " "ephemeral" true)}}
	{{if not (hasRoleID $db.Rank.RoleID)}}
		{{editResponse .Interaction.Token $x (componentBuilder "text" (printf "You cannot join this training as you are not a <@&%s>." $db.Rank.RoleID) "ephemeral" true)}}
		{{deleteInteractionResponse .Interaction.Token $x}}
		{{return}}
	{{end}}
	{{if in $db.Confirmed $targetMember.User.ID}}
		{{$newTraining := cslice}}
		{{range $db.Confirmed}}
			{{if eq . $targetMember.User.ID}}
				{{continue}}
			{{end}}
			{{$newTraining = $newTraining.Append .}}
		{{end}}
		{{$db.Set "Confirmed" $newTraining}}
		{{editResponse .Interaction.Token $x (componentBuilder "text" "You've removed your confirmation from this training." "ephemeral" true)}}
		{{deleteInteractionResponse .Interaction.Token $x}}
	{{else}}
		{{$logs := (dbGet 0 "trainingLogs").Value}}
		{{$hasTraining := false}}
		{{range $_, $log := $logs}}
			{{if not $log}}
				{{continue}}
			{{end}}
			{{if ne $log.User.ID $targetMember.User.ID}}
				{{continue}}
			{{end}}
			{{if eq $log.Type $db.Rank.RoleID}}
				{{$hasTraining = true}}
				{{break}}
			{{end}}
		{{end}}
		{{if $hasTraining}}
			{{editResponse .Interaction.Token $x (componentBuilder "text" "You've already completed the training for this role." "ephemeral" true)}}
			{{deleteInteractionResponse .Interaction.Token $x}}
			{{return}}
		{{end}}
		{{$db.Set "Confirmed" ($db.Confirmed.Append .User.ID)}}
		{{editResponse .Interaction.Token $x (componentBuilder "text" "You've added your confirmation to this training." "ephemeral" true)}}
		{{deleteInteractionResponse .Interaction.Token $x}}
	{{end}}
	{{$notificationContainer := (componentBuilder
		"allowed_mentions" (sdict
			"roles" (cslice $db.Rank.RoleID)
		)
		"container" (sdict
			"color" $db.Role.Color
			"components" (componentBuilder
				"text" (printf "# %s Training" $db.Rank.Name)
				"separator" true
				"text" (printf "> **ID**: #%d\n> **Host**: @%s (<@%d>)\n> **Time**: <t:%d:f>\n\nPlease use the button below to confirm/unconfirm attendance **at least** 5 minutes before.\n**You do not need to attend if you have PASSED a <@&%d> training**\n\nRequires: `%d`+ confirmations.\nYou will be pinged 5 minutes before with the server name if there are sufficient confirmations." $db.ID (reReplace $factionData.Value.Settings.NicknameRegex $db.Host.Nick "") $db.Host.User.ID $db.Time $db.Rank.RoleID $db.MinConfirms)
				"buttons" (cslice
					(cbutton "label" "Toggle Confirmation" "custom_id" (printf "iota_trainingJoin-%d" $db.ID) "style" "success")
					(cbutton "label" (printf "Confirmed: %s" (humanizeThousands (len $db.Confirmed))) "custom_id" "iota_trainingConfirm" "style" "secondary" "disabled" true)
				)
			)
		)
	)}}
	{{dbSetExpire $db.ID "trainingData" $db (toInt (($entry.ExpiresAt.Sub currentTime).Seconds))}}
	{{editMessage nil .Message.ID $notificationContainer}}
{{end}}

{{if reFind `End` .StrippedID}}
	{{$x := sendResponseRetID nil (componentBuilder "text" "Loading... " "ephemeral" true)}}
	{{if ne $db.Host.User.ID .User.ID}}
		{{editResponse .Interaction.Token $x (componentBuilder "text" "You cannot end this training as you are not the host." "ephemeral" true)}}
		{{deleteInteractionResponse .Interaction.Token $x}}
		{{return}}
	{{end}}
	{{$db.Set "Status" 3}}
	{{$closedContainer := componentBuilder
		"container" (sdict
			"color" 0xFF0000
			"components" (componentBuilder
				"section" (sdict
					"text" (printf "# %s Training Closed" $db.Rank.Name)
					"button" (cbutton "label" "Manage Outcome Report" "custom_id" (printf "iota_trainingOutcomeManage-%d" $db.ID) "style" "success")
				)
				"separator" true
				"text" "This training session has officially closed.\n\nStaff may now manage the outcome report using the button above."
			)
		)
	}}
	{{editMessage 1532346844712272003 $db.TrainingMsg $closedContainer}}
	{{scheduleUniqueCC $db.CCID nil (toInt (toDuration "45m").Seconds) (printf "MissingLog-%d" $db.ID) (sdict "Notice" .Notice "MissingLog" true)}}
	{{dbSetExpire $db.ID "trainingData" $db (toInt (($entry.ExpiresAt.Sub currentTime).Seconds))}}
	{{editResponse .Interaction.Token $x (componentBuilder "text" "Done!" "ephemeral" true)}}
	{{deleteInteractionResponse .Interaction.Token $x}}
	{{return}}
{{end}}

{{if reFind `Outcome` .StrippedID}}
	{{if reFind `Manage` .StrippedID}}
		{{$x := sendResponseRetID nil (componentBuilder "text" "Loading... " "ephemeral" true)}}
		{{if ne $db.Host.User.ID .User.ID}}
			{{editResponse .Interaction.Token $x (componentBuilder "text" "You cannot end this training as you are not the host." "ephemeral" true)}}
			{{deleteInteractionResponse .Interaction.Token $x}}
			{{return}}
		{{end}}
		{{$confirmContainer := componentBuilder
			"container" (sdict
				"components" (componentBuilder
					"section" (sdict
						"text" (printf "# Manage %s Training Report" $db.Rank.Name)
						"button" (cbutton "label" "Finish Training" "custom_id" (printf "iota_trainingOutcomeSubmit-%d" $db.ID) "style" "success")
					)
					"separator" false
					"section" (sdict
						"text" "### Attendees"
						"button" (cbutton "label" "Edit" "custom_id" (printf "iota_trainingOutcomeEditAttendees-%d" $db.ID) "style" "primary")
					)
					"section" (sdict
						"text" "### Passed"
						"button" (cbutton "label" "Edit" "custom_id" (printf "iota_trainingOutcomeEditPassed-%d" $db.ID) "style" "primary")
					)
					"section" (sdict
						"text" "### Proof"
						"button" (cbutton "label" "Edit & View" "custom_id" (printf "iota_trainingOutcomeEditProof-%d" $db.ID) "style" "primary")
					)
				)
			)
		}}
		{{editResponse .Interaction.Token $x $confirmContainer}}
	{{else if reFind `Edit` .StrippedID}}
		{{if reFind `Attendees` .StrippedID}}
			{{$confirmedUsersSlice := cslice}}
			{{range $db.Confirmed}}
				{{$member := getMember .}}
				{{$rblxName := reReplace $factionData.Value.Settings.NicknameRegex $member.Nick ""}}
				{{$selected := false}}{{if in $db.Attended $member.User.ID}}{{$selected = true}}{{end}}
				{{$confirmedUsersSlice = $confirmedUsersSlice.Append (sdict "value" (str $member.User.ID) "label" $rblxName "default" $selected)}}
			{{end}}
			{{$confirmedUsersDropdown := ccheckboxGroup
				"custom_id" "confirmedUsersDropdown"
				"options" $confirmedUsersSlice
				"min_values" 0
				"required" false
			}}
			{{$attendingLabel := clabel "label" "Attendees" "description" "Which of the confirmed users attended the training?" "component" $confirmedUsersDropdown}}
			{{$modal := modalBuilder (printf "iota_trainingOutcomeAttendees-%d" $db.ID) "Iota-4 | Training Outcome Form" $attendingLabel}}
			{{sendModal $modal}}
		{{else if (reFind `Passed` .StrippedID)}}
			{{if eq (len $db.Attended) 0}}
				{{$x := sendResponseRetID nil (componentBuilder "text" "Please confirm the attendance on members before you can grade them" "ephemeral" true)}}
				{{deleteInteractionResponse .Interaction.Token $x}}
				{{return}}
			{{end}}
			{{$confirmedUsersSlice := cslice}}
			{{range $db.Attended}}
				{{$member := getMember .}}
				{{$rblxName := reReplace $factionData.Value.Settings.NicknameRegex $member.Nick ""}}
				{{$selected := false}}{{if in $db.Passed $member.User.ID}}{{$selected = true}}{{end}}
				{{$confirmedUsersSlice = $confirmedUsersSlice.Append (sdict "value" (str $member.User.ID) "label" $rblxName "default" $selected)}}
			{{end}}
			{{$confirmedUsersDropdown := ccheckboxGroup
				"custom_id" "confirmedUsersDropdown"
				"options" $confirmedUsersSlice
				"min_values" 0
				"required" false
			}}
			{{$attendingLabel := clabel "label" "Passed" "description" "Which of the confirmed users passed the training?" "component" $confirmedUsersDropdown}}
			{{$modal := modalBuilder (printf "iota_trainingOutcomePassed-%d" $db.ID) "Iota-4 | Training Outcome Form" $attendingLabel}}
			{{sendModal $modal}}
		{{else if (reFind `Proof` .StrippedID)}}
			{{if reFind `ProofEdit` .StrippedID}}
				{{$proofLabel := clabel "label" "Proof" "description" "Screenshot of training" "component" (cfileUpload "custom_id" "uploadForm" "required" true)}}
				{{$modal := modalBuilder (printf "iota_trainingOutcomeProof-%d" $db.ID) "Iota-4 | Training Outcome Form" $proofLabel}}
				{{sendModal $modal}}
				{{return}}
			{{end}}
			{{$x := sendResponseRetID nil (componentBuilder "text" "Loading... " "ephemeral" true)}}
			{{$confirmContainer := componentBuilder
				"container" (sdict
					"components" (componentBuilder
						"section" (sdict
							"text" (printf "# Manage %s Training Report Proof" $db.Rank.Name)
							"button" (cbutton "label" "Edit" "custom_id" (printf "iota_trainingOutcomeEditProofEdit-%d" $db.ID) "style" "success")
						)
						"separator" false
						"gallery" (cslice
							(sdict "media" (or $db.Proof "https://iota-4.org/missingProof.png"))
						)
						"text" "-# If the image does not load, please edit the log."
					)
				)
			}}
			{{editResponse .Interaction.Token $x $confirmContainer}}
			{{deleteInteractionResponse .Interaction.Token $x}}
		{{end}}
	{{else}}
		{{$x := sendResponseRetID nil (componentBuilder "text" "Loading... " "ephemeral" true)}}
		{{if ne $db.Host.User.ID .User.ID}}
			{{editResponse .Interaction.Token $x (componentBuilder "text" "You cannot submit this training outcome as you are not the host." "ephemeral" true)}}
			{{deleteInteractionResponse .Interaction.Token $x}}
			{{return}}
		{{end}}
		{{if eq $db.Proof "" "https://iota-4.org/missingProof.png"}}
			{{editResponse .Interaction.Token $x (componentBuilder "text" "You cannot submit this training outcome as the proof image is missing." "ephemeral" true)}}
			{{deleteInteractionResponse .Interaction.Token $x}}
			{{return}}
		{{end}}
		{{$db.Set "Logged" true}}
		{{scheduleUniqueCC .CCID nil (toInt (toDuration "72h").Seconds) (printf "CloseLog-%d" $db.ID) (sdict "Notice" $db.ID "CloseLog" true)}}
		{{$logContainer := componentBuilder
			"container" (sdict
				"color" $db.Role.Color
				"components" (componentBuilder
					"section" (sdict
						"text" (printf "# %s Training Completed" $db.Rank.Name)
						"button" (cbutton "label" "Submit Training Log" "custom_id" (printf "iota_trainingLogSubmit-%d" $db.ID) "style" "success")
					)
					"separator" true
					"text" (printf "> **Host**: @%s (<@%d>)\n\nAttendees may now submit their training logs using the button above." (reReplace $factionData.Value.Settings.NicknameRegex $db.Host.Nick "") $db.Host.User.ID)
				)
			)
		}}
		{{editMessage 1532346844712272003 $db.TrainingMsg $logContainer}}
		{{dbSetExpire $db.ID "trainingData" $db (toInt ($entry.ExpiresAt.Sub currentTime).Seconds)}}
		{{editResponse .Interaction.Token $x (componentBuilder "text" "Done!" "ephemeral" true)}}
		{{deleteInteractionResponse .Interaction.Token $x}}
	{{end}}
	{{return}}
{{end}}

{{if reFind `LogSubmit` .StrippedID}}
	{{$existingLog := false}}
	{{$currentLogDB := dbGet $targetMember.User.ID (printf "trainingLog:%d" $db.Role.ID)}}
	{{if $currentLogDB}}
		{{$existingLog = true}}
	{{end}}
	{{if $existingLog}}
		{{$x := sendResponseRetID nil (complexMessage "content" "You have already submit a training for this rank.\nIf you can't see it, it may still be pending. Ask one of our Mission Control+ to accept it." "ephemeral" true)}}
		{{deleteInteractionResponse .Interaction.Token $x}}
		{{return}}
	{{end}}
	{{$attended := in $db.Attended $targetMember.User.ID}}
	{{if (in $db.Confirmed $targetMember.User.ID)}}
		{{if not $attended}}
			{{$x := sendResponseRetID nil (complexMessage "content" "You can not submit a log for this training as you did not attend this training." "ephemeral" true)}}
			{{deleteInteractionResponse .Interaction.Token $x}}
			{{return}}
		{{end}}
	{{end}}
	{{if $attended}}
		{{if not (in $db.Passed $targetMember.User.ID)}}
			{{$x := sendResponseRetID nil (complexMessage "content" "You can not submit a log for this training as you did not pass this training." "ephemeral" true)}}
			{{deleteInteractionResponse .Interaction.Token $x}}
			{{return}}
		{{end}}
	{{end}}
	{{$trainingConfidenceLabel := clabel 
		"label" "Training Self-Assessment"
		"description" "How confident are you performing this rank's duties following this training session"
		"component" (cradioGroup
			"custom_id" "trainingConfidenceInput"
			"options" (cslice
				(sdict
					"label" "Very Confident"
					"value" "Very Confident"
					"description" "I could confidently perform this role."
				)
				(sdict
					"label" "Confident"
					"value" "Confident"
					"description" "I'm comfortable, but could use more practice."
				)
				(sdict
					"label" "Somewhat Confident"
					"value" "Somewhat Confident"
					"description" "I understand the basics but need guidance."
				)
				(sdict
					"label" "Need More Practice"
					"value" "Need More Practice"
					"description" "I don't yet feel ready."
				)
			)
		)
	}}
	{{$feedbackLabel := clabel
		"label" "Trainer Feedback"
		"description" "Summarise the most important feedback or advice your trainer gave you during this session."
		"component" (ctextInput
			"custom_id" "trainingFeedbackInput"
			"style" 2
			"min_length" 20
			"max_length" 250
			"placeholder" "What feedback or advice did your trainer give you?"
		)
	}}
	{{$modal := modalBuilder (printf "iota_trainingSubmitLog-%d" $db.ID) "Iota-4 | Training Log Form" $trainingConfidenceLabel $feedbackLabel}}
	{{sendModal $modal}}
	{{return}}
{{end}}