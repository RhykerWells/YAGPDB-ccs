{{/*
	Made by ranger_4297 (765316548516380732)

	Trigger Type: `Regex`
	Trigger: `(c(ancel)?-?)?tr(ain(ing)?)?`

	©️ RhykerWells 2020-Present
	GNU, GPLV3 License
	Repository: https://github.com/RhykerWells/YAGPDB-ccs/
*/}}

{{$trigger := print `\A(?i)(?:\` .ServerPrefix `|<@!?` .BotUser.ID `>\*)(` .CCTrigger `)`}}
{{if not (reFind $trigger .Message.Content)}}
	{{return}}
{{end}}

{{$factionData := dbGet 0 "FactionDataV2"}}
{{if not $factionData}}
	{{sendResponse (componentBuilder "text" "FactionData not set up, please modify and run `-setData`" "ephemeral" true)}}
	{{return}}
{{end}}
{{$data := $factionData.Value}}
{{$ranksByDivision := $data.Get "RanksByDivision"}}
{{$rankLookup := $data.Get "RankLookup"}}

{{with .ExecData}}
	{{$db := (dbGet (toInt .Notice) "trainingData").Value}}
	{{$strConfirmed := cslice}}
	{{range $db.Confirmed}}
		{{$strConfirmed = $strConfirmed.Append (printf "<@%d>" .)}}
	{{end}}
	{{if .ActiveCheck}}
		{{if eq $db.Status 2}}
			{{$notificationContainer := (componentBuilder
				"container" (sdict
					"color" 0xFFAA00
					"components" (componentBuilder
						"text" "# Training Still Active"
						"separator" true
						"text" (printf "> **ID**: #%d\n> **Host**: @%s (<@%d>)\n> **Training Rank**: %s\n> **Link**: %s\n\nThis training has not been ended yet. Please press the **End** button once the training is complete." $db.ID (reReplace ` \|.*` $db.Host.Nick "") $db.Host.User.ID (printf "<@&%d>" $db.Rank.RoleID) (printf "https://discord.com/channels/1375370805575155782/1532346844712272003/%d" $db.TrainingMsg))
					)
				)
			)}}
			{{sendMessageNoEscape 1532358370433171628 $notificationContainer}}
			{{scheduleUniqueCC $.CCID nil (toInt (toDuration "45m").Seconds) (printf "ActiveCheck-%d" .Notice) (sdict "Notice" .Notice "ActiveCheck" true)}}
			{{return}}
		{{end}}
	{{end}}
	{{if .MissingLog}}
		{{if not $db.Logged}}
			{{$notificationContainer := (componentBuilder
				"container" (sdict
					"color" 0xFF0000
					"components" (componentBuilder
						"text" (printf "# Missing Training Outcome Report")
						"separator" true
						"text" (printf "> **ID**: #%d\n> **Host**: @%s (<@%d>)\n> **Training Rank**: %s\n> **Link**: %s\n\nThe following users are waiting for the training outcome to be recorded:\n- %s" $db.ID (reReplace ` \|.*` $db.Host.Nick "") $db.Host.User.ID (printf "<@&%d>" $db.Rank.RoleID) (printf "https://discord.com/channels/1375370805575155782/1532346844712272003/%d" $db.TrainingMsg) (joinStr "\n-" $strConfirmed))
					)
				)
			)}}
			{{sendMessage 1532358370433171628 $notificationContainer}}
			{{scheduleUniqueCC $.CCID nil (toInt (toDuration "2h").Seconds) (printf "MissingLog-%d" .Notice) (sdict "Notice" .Notice "MissingLog" true)}}
			{{return}}
		{{end}}
	{{end}}
	{{$buttonState := cslice
		(cbutton
			"label" "Toggle Confirmation"
			"custom_id" (printf "iota_trainingJoin-%d" $db.ID)
			"style" "success"
			"disabled" true
		)
		(cbutton
			"label" (printf "Confirmed: %s" (humanizeThousands (len $db.Confirmed)))
			"custom_id" "iota_trainingConfirm"
			"style" "secondary"
			"disabled" true
		)
	}}
	{{if lt (len $strConfirmed) $db.MinConfirms}}
		{{$cancelledContainer := componentBuilder
			"container" (sdict
				"color" 0xFF0000
				"components" (componentBuilder
					"text" (printf "# %s Training Cancelled" $db.Rank.Name)
					"separator" true
					"text" "Insufficient confirmations were received within the required timeframe."
					"buttons" $buttonState
				)
			)
		}}
		{{dbDel $db.ID "trainingData"}}
		{{editMessage 1532346844712272003 $db.TrainingMsg $cancelledContainer}}
		{{$confirmedUsers := ""}}
		{{if gt (len $strConfirmed) 0}}
			{{$confirmedUsers = printf "\n\nThe following users confirmed the training session:\n%s" (joinStr "\n" $strConfirmed)}}
		{{end}}
		{{sendMessage nil (componentBuilder "allowed_mentions" (sdict "users" (cslice)) "text" (printf "Insufficient confirmations within the time frame for %s training.%s" $db.Rank.Name $confirmedUsers))}}
		{{return}}
	{{end}}
	{{$successContainer := componentBuilder
		"container" (sdict
			"color" 0x4b9a4e
			"components" (componentBuilder
				"section" (sdict
					"text" (printf "# %s Training" $db.Rank.Name)
					"button" (cbutton "label" "End" "custom_id" (printf "iota_trainingEnd-%d" $db.ID) "style" "primary")
				)
				"separator" true
				"text" (printf "The training has enough confirmations and will proceed.\n\nThe host will provide the server name shortly.")
			)
		)
	}}
	{{editMessage 1532346844712272003 $db.TrainingMsg $successContainer}}
	{{$successContainer2 := componentBuilder
		"reply" $db.TrainingMsg
		"container" (sdict
			"components" (componentBuilder
				"text" (joinStr ", " $strConfirmed)
			)
		)
	}}
	{{$db.Set "Status" 2}}
	{{dbSet $db.ID "trainingData" $db}}
	{{$x := sendMessageNoEscapeRetID 1532346844712272003 $successContainer2}}
	{{deleteMessage 1532346844712272003 $x (toInt (toDuration "5m").Seconds)}}
	{{scheduleUniqueCC $.CCID nil (toInt (toDuration "45m").Seconds) (printf "ActiveCheck-%d" .Notice) (sdict "Notice" .Notice "ActiveCheck" true)}}
	{{return}}
{{end}}

{{if reFind `^-(?:c|cancel)-?` .Cmd}}
	{{if not .CmdArgs}}
		{{sendMessage nil (printf "Missing required arguments\n\n```cancel-training <ID>```")}}
		{{return}}
	{{end}}
	{{$ID := index .CmdArgs 0}}
	{{if not (toInt $ID)}}
		{{sendMessage nil (printf "Invalid `Training` argument.\n\n```cancel-training <ID>```")}}
		{{return}}
	{{end}}
	{{$db := dbGet (toInt $ID) "trainingData"}}
	{{if not $db}}
		{{sendMessage nil (printf "Invalid `Training` argument.\n\n```cancel-training <ID>```")}}
		{{return}}
	{{end}}
	{{$db = $db.Value}}
	{{$reason := "(No reason provided)"}}
	{{if gt (len .CmdArgs) 2}}
		{{$reason = joinStr " " (slice .CmdArgs 1)}}
	{{end}}
	{{if eq $db.Status 3}}
		{{sendMessage nil (printf "You are unable to cancel this training at it's current stage.")}}
		{{return}}
	{{end}}
	{{$buttonState := cslice
		(cbutton
			"label" "Toggle Confirmation"
			"custom_id" (printf "iota_trainingJoin-%d" $db.ID)
			"style" "success"
			"disabled" true
		)
		(cbutton
			"label" (printf "Confirmed: %s" (humanizeThousands (len $db.Confirmed)))
			"custom_id" "iota_trainingConfirm"
			"style" "secondary"
			"disabled" true
		)
	}}
	{{$cancelledContainer := componentBuilder
			"container" (sdict
				"color" 0xFF0000
				"components" (componentBuilder
					"text" (printf "# %s Training Cancelled" $db.Rank.Name)
					"separator" true
					"text" $reason
					"buttons" $buttonState
				)
			)
		}}
		{{dbDel $db.ID "trainingData"}}
		{{cancelScheduledUniqueCC $db.CCID "start"}}
		{{cancelScheduledUniqueCC $db.CCID "ActiveCheck"}}
		{{cancelScheduledUniqueCC $db.CCID "MissingLog"}}
		{{editMessage 1532346844712272003 $db.TrainingMsg $cancelledContainer}}
		{{sendMessage nil "You have successfully cancelled this training"}}
	{{return}}
{{end}}

{{$coreRanks := $ranksByDivision.Get "Core"}}
{{$availableRanks := cslice}}
{{range $coreRanks}}
	{{$rank := $rankLookup.Get .}}
	{{if $rank.PromotionData}}
		{{$availableRanks = $availableRanks.Append $rank.ShortName}}
	{{end}}
{{end}}

{{if not .CmdArgs}}
	{{sendMessage nil (printf "Missing required arguments\n\n```training <Rank> <Duration> [Minimum Confirmations]```\nAvailable ranks: `%s`" (joinStr "`, `" $availableRanks))}}
	{{return}}
{{end}}
{{$targetRankName := index .CmdArgs 0}}
{{if not (in $availableRanks $targetRankName)}}
	{{sendMessage nil (printf "Invalid `Rank` argument.\n\n```training <Rank> <Duration> [Minimum Confirmations]```\nAvailable ranks: `%s`" (joinStr "`, `" $availableRanks))}}
	{{return}}
{{end}}
{{$targetRank := sdict}}
{{range $coreRanks}}
	{{$rank := $rankLookup.Get .}}
	{{if and (eq $rank.ShortName $targetRankName) $rank.PromotionData}}
		{{$targetRank = $rank}}
	{{end}}
{{end}}
{{if not (gt (len .CmdArgs) 1)}}
	{{sendMessage nil "No `Duration` argument provided.\n\n```training <Rank> <Duration> [Minimum Confirmations]```\nIn how long do you want to host the training (please be exact)?\nExample: `2h15m` - 2 hours 15 minutes\nMinimum duration is `10m`."}}
	{{return}}
{{end}}
{{$duration := index .CmdArgs 1}}
{{if not (toDuration $duration)}}
	{{sendMessage nil "Invalid `Duration` argument provided.\n\n```training <Rank> <Duration> [Minimum Confirmations]```\nIn how long do you want to host the training (please be exact)?\nExample: `2h15m` - 2 hours 15 minutes\nMinimum duration is `10m`."}}
	{{return}}
{{end}}
{{if lt (toDuration $duration) (toDuration "10m")}}
	{{sendMessage nil "Invalid `Duration` argument provided.\n\n```training <Rank> <Duration> [Minimum Confirmations]```\nIn how long do you want to host the training (please be exact)?\nExample: `2h15m` - 2 hours 15 minutes\nMinimum duration is `10m`."}}
	{{return}}
{{end}}
{{$minimumConfirmations := 3}}
{{if (gt (len .CmdArgs) 2)}}
	{{$minimumConfirmations = index .CmdArgs 2 | toInt}}
	{{if not $minimumConfirmations}}
		{{sendMessage nil "Invalid `Minimum confirmations` argument provided.\n\n```training <Rank> <Duration> [Minimum Confirmations]```\nHow many confirmations do you want to require for the training? (must be at least `1`)"}}
		{{return}}
	{{end}}
	{{if lt $minimumConfirmations 1}}
		{{sendMessage nil "Invalid `Minimum confirmations` argument provided.\n\n```training <Rank> <Duration> [Minimum Confirmations]```\nHow many confirmations do you want to require for the training? (must be at least `1`)"}}
		{{return}}
	{{end}}
{{end}}
{{$ID := dbIncr 0 "trainingNotice" 1 | toInt}}
{{$dbData := sdict
	"ID" $ID
	"CCID" .CCID
	"Host" .Member
	"Rank" $targetRank
	"Role" (getRoleID $targetRank.RoleID)
	"Time"  (currentTime.Add (toDuration $duration)).Unix

	"Confirmed" cslice
	"Attended" cslice
	"Passed" cslice

	"Summary" ""
	"Proof" ""

	"Logged" false
	"Status" 1

	"TrainingMsg" 0

	"MinConfirms" $minimumConfirmations
}}

{{$notificationContainer := (componentBuilder
	"allowed_mentions" (sdict
		"roles" (cslice (toInt $targetRank.RoleID))
	)
	"container" (sdict
		"color" $dbData.Role.Color
		"components" (componentBuilder
			"text" (printf "# %s Training" $targetRank.Name)
			"separator" true
			"text" (printf "> **ID**: #%d\n> **Host**: @%s (<@%d>)\n> **Time**: <t:%d:f>\n\nPlease use the button below to confirm/unconfirm attendance **at least** 5 minutes before.\n**You do not need to attend if you have PASSED a <@&%d> training**\n\nRequires: `%d`+ confirmations.\nYou will be pinged 5 minutes before with the server name if there are sufficient confirmations." $dbData.ID (reReplace ` \|.*` $dbData.Host.Nick "") $dbData.Host.User.ID $dbData.Time $dbData.Rank.RoleID $dbData.MinConfirms)
			"buttons" (cslice
				(cbutton "label" "Toggle Confirmation" "custom_id" (printf "iota_trainingJoin-%d" $dbData.ID) "style" "success")
				(cbutton "label" "Confirmed: 0" "custom_id" "iota_trainingConfirm" "style" "secondary" "disabled" true)
			)
		)
	)
)}}

{{$x := sendMessageRetID 1532346844712272003 $notificationContainer}}
{{$dbData.Set "TrainingMsg" $x}}
{{sendMessage nil (printf "You've successfully started a(n) %s training notice for <t:%d:f>. [View #%d here](https://discord.com/channels/1375370805575155782/1532346844712272003/%d)" $targetRank.Name (currentTime.Add (toDuration $duration)).Unix $ID $x)}}
{{dbSetExpire $ID "trainingData" $dbData (toInt (toDuration "14d").Seconds)}}
{{scheduleUniqueCC .CCID nil (toDuration (sub (toDuration $duration) (toDuration "5m"))).Seconds (printf "Start-%d" $ID) (sdict "Notice" $ID)}}