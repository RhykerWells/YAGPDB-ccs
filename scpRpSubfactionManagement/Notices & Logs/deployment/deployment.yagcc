{{/*
		Made by ranger_4297 (765316548516380732)

	Trigger Type: `Regex`
	Trigger: `((e(mergency)?|c(ancel)?)-?)?dep(o|loy(ment)?)`

	©️ RhykerWells 2020-Present
	GNU, GPLV3 License
	Repository: https://github.com/RhykerWells/YAGPDB-ccs/tree/iota-4
*/}}

{{$trigger := print `\A(?i)(?:\` .ServerPrefix `|<@!?` .BotUser.ID `>\*)(` .CCTrigger `)`}}
{{if not (or (reFind $trigger .Message.Content) .ExecData)}}
	{{return}}
{{end}}

{{$factionData := dbGet 0 "FactionDataV2"}}
{{if not $factionData}}
	{{sendResponse (componentBuilder "text" "FactionData not set up, please modify and run `-setData`" "ephemeral" true)}}
	{{return}}
{{end}}

{{with .ExecData}}
	{{$db := 0}}
	{{$strConfirmed := cslice}}
	{{if .Notice}}
		{{$db = (dbGet (toInt .Notice) "deploymentData").Value}}
		{{range $db.Confirmed}}
			{{$strConfirmed = $strConfirmed.Append (printf "<@%d>" .)}}
		{{end}}
	{{end}}
	{{if .MID}}
		{{editMessage nil .MID (componentBuilder
			"text" "Press the button below to start an emergency deployment."
			"buttons" (cslice
				(cbutton
					"label" "Start Emergency Deployment"
					"custom_id" "iota_deploymentStartEmergency"
					"style" "danger"
					"disabled" true
				)
			)
		)}}
		{{return}}
	{{end}}
	{{if .ActiveCheck}}
		{{if eq $db.Status 2}}
			{{$notificationContainer := (componentBuilder
				"container" (sdict
					"color" 0xFFAA00
					"components" (componentBuilder
						"text" "# Deployment Still Active"
						"separator" true
						"text" (printf "> **ID**: #%d\n> **Host**: @%s (<@%d>)\n> **Link**: %s\n\nThis deployment has not been ended yet. Please press the **End** button once the deployment is complete." $db.ID $db.Host.Roblox $db.Host.ID (printf "https://discord.com/channels/1375370805575155782/1532346772578373864/%d" $db.DeployMsg))
					)
				)
			)}}
			{{sendMessageNoEscape 1532358370433171628 $notificationContainer}}
			{{scheduleUniqueCC $.CCID nil (toInt (toDuration "45m").Seconds) (printf "ActiveCheck-%d" .Notice) (sdict "Notice" .Notice "ActiveCheck" true)}}
		{{end}}
		{{return}}
	{{end}}
	{{if .MissingLog}}
		{{if not $db.Logged}}
			{{$notificationContainer := (componentBuilder
				"container" (sdict
					"color" 0xFF0000
					"components" (componentBuilder
						"text" (printf "# Missing Deployment Outcome Report")
						"separator" true
						"text" (printf "> **ID**: #%d\n> **Host**: @%s (<@%d>)\n> **Link**: %s\n\nThe following users are waiting for the deployment outcome to be recorded:\n- %s" $db.ID $db.Host.Roblox $db.Host.ID (printf "https://discord.com/channels/1375370805575155782/1532346772578373864/%d" $db.DeployMsg) (joinStr "\n- " $strConfirmed))
					)
				)
			)}}
			{{sendMessage 1532358370433171628 $notificationContainer}}
			{{scheduleUniqueCC $.CCID nil (toInt (toDuration "2h").Seconds) (printf "MissingLog-%d" .Notice) (sdict "Notice" .Notice "MissingLog" true)}}
		{{end}}
		{{return}}
	{{end}}
	{{$buttonState := cslice
		(cbutton
			"label" "Toggle Confirmation"
			"custom_id" (printf "iota_deploymentJoin-%d" $db.ID)
			"style" "success"
			"disabled" true
		)
		(cbutton
			"label" (printf "Confirmed: %s" (humanizeThousands (len $db.Confirmed)))
			"custom_id" "iota_deploymentConfirm"
			"style" "secondary"
			"disabled" true
		)
	}}
	{{if lt (len $strConfirmed) $db.MinConfirms}}
		{{$cancelledContainer := componentBuilder
			"container" (sdict
				"color" 0xFF0000
				"components" (componentBuilder
					"text" "# Deployment Cancelled"
					"separator" true
					"text" "Insufficient confirmations were received within the required timeframe."
					"buttons" $buttonState
				)
			)
		}}
		{{dbDel $db.ID "deploymentData"}}
		{{editMessage 1532346772578373864 $db.DeployMsg $cancelledContainer}}
		{{$confirmedUsers := ""}}
		{{if gt (len $strConfirmed) 0}}
			{{$confirmedUsers = printf "\n\nThe following users confirmed the deployment:\n%s" (joinStr "\n" $strConfirmed)}}
		{{end}}
		{{sendMessage nil (componentBuilder "allowed_mentions" (sdict "users" (cslice)) "text" (printf "Insufficient confirmations within the time frame for the deployment.%s" $confirmedUsers))}}
		{{return}}
	{{end}}
	{{$successContainer := componentBuilder
		"container" (sdict
			"color" 0x4b9a4e
			"components" (componentBuilder
				"section" (sdict
					"text" "# Deployment"
					"button" (cbutton "label" "End" "custom_id" (printf "iota_deploymentEnd-%d" $db.ID) "style" "primary")
				)
				"separator" true
				"text" (printf "The deployment has enough confirmations and will proceed.\n\nThe host will provide the server name shortly.")
			)
		)
	}}
	{{editMessage 1532346772578373864 $db.DeployMsg $successContainer}}
	{{$successContainer2 := componentBuilder
		"reply" $db.DeployMsg
		"container" (sdict
			"components" (componentBuilder
				"text" (joinStr ", " $strConfirmed)
			)
		)
	}}
	{{$db.Set "Status" 2}}
	{{dbSet $db.ID "deploymentData" $db}}
	{{$x := sendMessageNoEscapeRetID 1532346772578373864 $successContainer2}}
	{{deleteMessage 1532346772578373864 $x (toInt (toDuration "5m").Seconds)}}
	{{scheduleUniqueCC $.CCID nil (toInt (toDuration "45m").Seconds) (printf "ActiveCheck-%d" .Notice) (sdict "Notice" .Notice "ActiveCheck" true)}}
	{{return}}
{{end}}

{{if reFind `^-(?:c|cancel)-?` .Cmd}}
	{{if not .CmdArgs}}
		{{sendMessage nil (printf "Missing required arguments\n\n```cancel-deployment <ID>```")}}
		{{return}}
	{{end}}
	{{$ID := index .CmdArgs 0}}
	{{if not (toInt $ID)}}
		{{sendMessage nil (printf "Invalid `ID` argument.\n\n```cancel-deployment <ID>```")}}
		{{return}}
	{{end}}
	{{$db := dbGet (toInt $ID) "deploymentData"}}
	{{if not $db}}
		{{sendMessage nil (printf "Invalid `ID` argument.\n\n```cancel-deployment <ID>```")}}
		{{return}}
	{{end}}
	{{$db = $db.Value}}
	{{$reason := "(No reason provided)"}}
	{{if gt (len .CmdArgs) 2}}
		{{$reason = joinStr " " (slice .CmdArgs 1)}}
	{{end}}
	{{if eq $db.Status 3}}
		{{sendMessage nil (printf "You are unable to cancel this deployment at it's current stage.")}}
		{{return}}
	{{end}}
	{{$buttonState := cslice
		(cbutton
			"label" "Toggle Confirmation"
			"custom_id" (printf "iota_deploymentJoin-%d" $db.ID)
			"style" "success"
			"disabled" true
		)
		(cbutton
			"label" (printf "Confirmed: %s" (humanizeThousands (len $db.Confirmed)))
			"custom_id" "iota_deploymentConfirm"
			"style" "secondary"
			"disabled" true
		)
	}}
	{{$cancelledContainer := componentBuilder
			"container" (sdict
				"color" 0xFF0000
				"components" (componentBuilder
					"text" "# Deployment Cancelled"
					"separator" true
					"text" $reason
					"buttons" $buttonState
				)
			)
		}}
		{{dbDel $db.ID "deploymentData"}}
		{{cancelScheduledUniqueCC $db.CCID (printf "Start-%d" .Notice)}}
		{{cancelScheduledUniqueCC $db.CCID (printf "ActiveCheck-%d" .Notice)}}
		{{cancelScheduledUniqueCC $db.CCID (printf "MissingLog-%d" .Notice)}}
		{{editMessage 1532346772578373864 $db.DeployMsg $cancelledContainer}}
		{{sendMessage nil "You have successfully cancelled this deployment"}}
	{{return}}
{{end}}

{{if reFind `^-(?:e|emergency)-?` .Cmd}}
	{{$reason := "(No reason provided)"}}
	{{with .CmdArgs}}
		{{$reason = joinStr " " (slice . 0)}}
	{{end}}
	{{$ID := dbIncr 0 "deploymentNotice" 1 | toInt}}
	{{$x := sendMessageRetID nil (componentBuilder
		"text" "Press the button below to start an emergency deployment."
		"buttons" (cslice
			(cbutton
				"label" "Start Emergency Deployment"
				"custom_id" (printf "iota_deploymentStartEmergency-%s" $ID)
				"style" "danger"
			)
		)
	)}}
	{{$dbData := sdict
		"ID" $ID
		"CCID" .CCID
		"Host" (sdict "Roblox" (reReplace ` \|.*` .Member.Nick "") "ID" .User.ID)
		"Time"  currentTime.Unix

		"Confirmed" cslice

		"Summary" ""
		"Proof" ""
		"Reason" $reason

		"Logged" false
		"Status" 1

		"DeployMsg" 0

		"MinConfirms" 0
	}}
	{{dbSetExpire $dbData.ID "deploymentData" $dbData (toInt (toDuration "14d").Seconds)}}
	{{scheduleUniqueCC .CCID nil  (toDuration "10s").Seconds "TimeoutStartEmergency" (sdict "MID" $x  "Emergency" true)}}
	{{return}}
{{end}}

{{if not .CmdArgs}}
	{{sendMessage nil "Missing required arguments.\n\n```deploy <Duration> [Minimum Confirmations]```"}}
	{{return}}
{{end}}
{{$duration := index .CmdArgs 0}}
{{if not (toDuration $duration)}}
	{{sendMessage nil "Invalid `Duration` argument provided.\n\n```deploy <Duration> [Minimum Confirmations]```\nIn how long do you want to host the deployment (please be exact)?\nExample: `2h15m` - 2 hours 15 minutes\nMinimum duration is `10m`."}}
	{{return}}
{{end}}
{{if lt (toDuration $duration) (toDuration "10m")}}
	{{sendMessage nil "Invalid `Duration` argument provided.\n\n```deploy <Duration> [Minimum Confirmations]```\nIn how long do you want to host the deployment (please be exact)?\nExample: `2h15m` - 2 hours 15 minutes\nMinimum duration is `10m`."}}
	{{return}}
{{end}}
{{$minimumConfirmations := 3}}
{{if (gt (len .CmdArgs) 1)}}
	{{$minimumConfirmations = index .CmdArgs 1 | toInt}}
	{{if not $minimumConfirmations}}
		{{sendMessage nil "Invalid `Minimum confirmations` argument provided.\n\n```deploy <Duration> [Minimum Confirmations]```\nHow many confirmations do you want to require for the deployment? (must be at least `3`)"}}
		{{return}}
	{{end}}
	{{if lt $minimumConfirmations 1}}
		{{sendMessage nil "Invalid `Minimum confirmations` argument provided.\n\n```deploy <Duration> [Minimum Confirmations]```\nHow many confirmations do you want to require for the deployment? (must be at least `3`)"}}
		{{return}}
	{{end}}
{{end}}
{{$ID := dbIncr 0 "deploymentNotice" 1 | toInt}}

{{$dbData := sdict
	"ID" $ID
	"CCID" .CCID
	"Host" (sdict "Roblox" (reReplace ` \|.*` .Member.Nick "") "ID" .User.ID)
	"Time"  (currentTime.Add (toDuration $duration)).Unix

	"Confirmed" cslice

	"Summary" ""
	"Proof" ""

	"Logged" false
	"Status" 1

	"DeployMsg" 0

	"MinConfirms" $minimumConfirmations
}}

{{$notificationContainer := (componentBuilder
	"allowed_mentions" (sdict
		"roles" (cslice 1375381774204665917)
		"users" (cslice)
	)
	"text" "<@&1375381774204665917>"
	"container" (sdict
		"components" (componentBuilder
			"text" "# Deployment Scheduled"
			"separator" true
			"text" (printf "> **ID**: #%d\n> **Host**: @%s (<@%d>)\n> **Time**: <t:%d:f>\n\nPlease use the button below to confirm/unconfirm attendance **at least** 5 minutes before.\n**You cannot log this deployment if you have not PASSED a training for your role**.\n\nRequires: `%d`+ confirmations.\nYou will be pinged 5 minutes before if there are sufficient confirmations." $dbData.ID $dbData.Host.Roblox $dbData.Host.ID $dbData.Time $dbData.MinConfirms)
			"buttons" (cslice
				(cbutton "label" "Toggle Confirmation" "custom_id" (printf "iota_deploymentJoin-%d" $dbData.ID) "style" "success")
				(cbutton "label" "Confirmed: 0" "custom_id" "iota_deploymentConfirm" "style" "secondary" "disabled" true)
			)
		)
	)
)}}

{{$x := sendMessageRetID 1532346772578373864 $notificationContainer}}
{{$dbData.Set "DeployMsg" $x}}
{{sendMessage nil (printf "You've successfully started a deployment notice for <t:%d:f>. [View #%d here](https://discord.com/channels/1375370805575155782/1532346772578373864/%d)" $dbData.Time $ID $x)}}
{{dbSetExpire $ID "deploymentData" $dbData (toInt (toDuration "14d").Seconds)}}
{{scheduleUniqueCC .CCID nil (toDuration (sub (toDuration $duration) (toDuration "5m"))).Seconds (printf "Start-%d" $ID) (sdict "Notice" $ID)}}