{{/*
Made by ranger_4297 (765316548516380732)

Trigger Type: `Modal`
Trigger: `\A(?i)iota_deployment`

©️ RhykerWells 2020-Present
GNU, GPLV3 License
Repository: https://github.com/RhykerWells/YAGPDB-ccs/
*/}}

{{$factionData := dbGet 0 "FactionDataV2"}}
{{if not $factionData}}
	{{sendResponse nil "FactionData not set up, please modify and run `-setData`"}}
	{{return}}
{{end}}

{{$deploymentID := reReplace `[A-z]+-` .StrippedID "" | toInt}}
{{$deployedAsRoleID := 0}}
{{if reFind `SubmitLog` .StrippedID}}
	{{$parts := split .StrippedID "-"}}
	{{$deploymentID = toInt (index $parts 1)}}
	{{$deployedAsRoleID = toInt (index $parts 2)}}
{{end}}
{{$entry := dbGet $deploymentID "deploymentData"}}
{{$db := $entry.Value}}
{{$self := (reFind `Self` .StrippedID)}}
{{if and (not $self) (not $db)}}
	{{sendResponse nil (componentBuilder "text" "Something went wrong" "ephemeral" true)}}
	{{return}}
{{end}}

{{if reFind `Outcome` .StrippedID}}
	{{$x := sendResponseRetID nil (componentBuilder "text" "Loading..." "ephemeral" true)}}
	{{if reFind `Proof` .StrippedID}}
		{{range $_, $v := .InteractionData.Resolved.Attachments}}
			{{$url := reReplace "\u0026" $v.URL "&"}}
			{{$db.Set "Proof" $url}}
			{{break}}
		{{end}}
	{{end}}
	{{dbSetExpire $db.ID "deploymentData" $db (toInt (($entry.ExpiresAt.Sub currentTime).Seconds))}}
	{{editResponse .Interaction.Token $x (componentBuilder "text" "Done!" "ephemeral" true)}}
	{{deleteInteractionResponse .Interaction.Token $x}}
{{end}}

{{if reFind `SubmitLog` .StrippedID}}
	{{$x := sendResponseRetID nil (componentBuilder "text" "Loading..." "ephemeral" true)}}
	{{$logID := dbIncr 0 "NewDlog" 1 | toInt}}
	{{if $self}}
		{{$db = (sdict
			"Sessions" 0
			"User" (sdict "ID" .User.ID "RobloxName" (reReplace $factionData.Value.Settings.NicknameRegex .Member.Nick ""))
			"Host" (sdict "ID" .User.ID "RobloxName" (reReplace $factionData.Value.Settings.NicknameRegex .Member.Nick ""))
		)}}
		{{range $_, $v := .InteractionData.Resolved.Attachments}}
			{{$url := reReplace "\u0026" $v.URL "&"}}
			{{$db.Set "Proof" $url}}
			{{break}}
		{{end}}
	{{end}}
	{{$deploymentLog := sdict
		"ID" $logID
		"Session" $db.ID
		"MsgID" 0
		"User" (sdict "ID" .User.ID "RobloxName" (reReplace $factionData.Settings.NicknameRegex .Member.Nick ""))
		"Host" (sdict "ID" $db.Host.ID "RobloxName" $db.Host.Roblox)
		"DeployedAs" $deployedAsRoleID
		"Duties" .ModalValues.deploymentDutiesInput.value
		"Incident" .ModalValues.deploymentIncidentInput.value
		"Proof" $db.Proof
		"Official" (not $self)
	}}
	{{$threads := (dbGet 0 "deploymentLogThreads").Value}}
	{{if not $threads}}
		{{$threads = sdict}}
	{{end}}
	{{$logChannel := $threads.Get $deploymentLog.User.RobloxName}}
	{{if $logChannel}}
		{{openThread (toInt $logChannel)}}
	{{else}}
		{{try}}
			{{$logChannel = (createForumPost 1534690514572542092 $deploymentLog.User.RobloxName (printf "%s's deployment log" .User.Mention)).ID}}
		{{catch}}
			{{sendMessage nil (complexMessage "ephemeral" true "content" "Was not able to create a forum post channel for deployment log. Your log has not been saved.")}}
			{{return}}
		{{end}}
		{{$threads.Set $deploymentLog.User.RobloxName $logChannel}}
		{{dbSet 0 "deploymentLogThreads" $threads}}
	{{end}}
	{{$logContainer := false}}
	{{if $self}}
		{{$logContainer = (componentBuilder
			"allowed_mentions" (sdict
				"parse" cslice
			)
			"container" (sdict
				"accent_color" 0x4b9a4e
				"components" (componentBuilder
					"text" (printf "# Self Deployment Log #%d" $deploymentLog.ID)
					"separator" true
					"text" (printf
						"**Self Deployment**\n\n**User**\n%s (<@%d>)\n\n**Deployment Rank**\n<@&%d>\n\n**Duties**\n%s\n\n**Incident(s)**\n%s" $deploymentLog.User.RobloxName $deploymentLog.User.ID $deploymentLog.DeployedAs $deploymentLog.Duties $deploymentLog.Incident
					)
					"separator" false
					"gallery" (cslice
						(sdict
							"media" (or $deploymentLog.Proof "https://iota-4.org/missingProof.png")
						)
					)
				)
			)
		)}}
	{{else}}
		{{$logContainer = (componentBuilder
			"allowed_mentions" (sdict
				"parse" cslice
			)
			"container" (sdict
				"accent_color" 0x4b9a4e
				"components" (componentBuilder
					"text" (printf "# Deployment Log #%d" $deploymentLog.ID)
					"separator" true
					"text" (printf
						"**User**\n%s (<@%d>)\n\n**Deployment Rank**\n<@&%d>\n\n**Deployment Host**\n%s (<@%d>)\n\n**Duties**\n%s\n\n**Incident(s)**\n%s" $deploymentLog.User.RobloxName $deploymentLog.User.ID $deploymentLog.DeployedAs $deploymentLog.Host.RobloxName $deploymentLog.Host.ID $deploymentLog.Duties $deploymentLog.Incident
					)
					"separator" false
					"gallery" (cslice
						(sdict
							"media" (or $deploymentLog.Proof "https://iota-4.org/missingProof.png")
						)
					)
				)
			)
		)}}
	{{end}}
	{{$dLogID := sendMessageRetID $logChannel $logContainer}}
	{{$deploymentLog.Set "MsgID" $dLogID}}
	{{$userData := or (dbGet $deploymentLog.User.ID "deploymentData").Value (sdict "Logs" cslice "LogsByRank" dict)}}
	{{$userData.Set "Logs" ($userData.Logs.Append $deploymentLog)}}
	{{$logsByRank := or ($userData.LogsByRank.Get $deploymentLog.DeployedAs) cslice}}
	{{$logsByRank = $logsByRank.Append $deploymentLog.ID}}
	{{$userData.LogsByRank.Set $deploymentLog.DeployedAs $logsByRank}}
	{{dbSet $deploymentLog.User.ID "deploymentData" $userData}}
	{{editResponse .Interaction.Token $x (componentBuilder "text" (printf "Done!\nLog created [here](https://discord.com/channels/%d/%d/%d)" .Guild.ID $logChannel $dLogID) "ephemeral" true)}}
	{{template "checkRequestPromotion" (sdict "GuildID" .Guild.ID "UserID" $deploymentLog.User.ID "RankID" $deploymentLog.DeployedAs "UserData" $userData "LogChannel" $logChannel "FactionData" $factionData.Value)}}
	{{deleteInteractionResponse .Interaction.Token $x}}
{{end}}

{{define "checkRequestPromotion"}}
	{{$member := getMember .UserID}}
	{{$currentRank := sdict}}
	{{range .FactionData.AllRanks}}
		{{if eq .RoleID $.RankID}}
			{{$currentRank = .}}
			{{break}}
		{{end}}
	{{end}}

	{{if not $currentRank.PromotionData}}
		{{return}}
	{{end}}

	{{$rankLogIDs := or (.UserData.LogsByRank.Get $currentRank.RoleID) cslice}}

	{{/* Only count official deployment logs */}}
	{{$rankLogs := cslice}}
	{{$officialRankLogs := cslice}}
	{{range $rankLogIDs}}
		{{$logID := .}}
		{{range $.UserData.Logs}}
			{{$rankLogs = $rankLogs.Append .}}
			{{if and (eq .ID $logID) .Official}}
				{{$officialRankLogs = $officialRankLogs.Append .}}
				{{break}}
			{{end}}
		{{end}}
	{{end}}

	{{/* Check official deployment requirement */}}
	{{if lt (len $officialRankLogs) $currentRank.PromotionData.DeploymentsRequired}}
		{{return}}
	{{end}}

	{{$nextRank := .FactionData.RankLookup.Get $currentRank.PromotionData.NextRankID}}

	{{$links := cslice}}
	{{range $officialRankLogs}}
		{{$links = $links.Append (printf "- [#%d](https://discord.com/channels/%d/%d/%d)" .ID $.GuildID $.LogChannel .MsgID)}}
	{{end}}

	{{$promotionContainer := (componentBuilder
		"allowed_mentions" (sdict
			"parse" cslice
		)
		"container" (sdict
			"color" 0xFFAA00
			"components" (componentBuilder
				"section" (sdict
					"text" (printf "# Promotion Requirements Met\n>>> **User**: @%s (%s)\n**Promotion**: <@&%d>\n**Status**: Pending review" (index .UserData.Logs 0).User.RobloxName $member.User.Mention $nextRank.RoleID)
					"thumbnail" (sdict
						"media" ($member.User.AvatarURL "1024")
					)
				)
				"text" (printf "## Eligible Deployments\n%s" (joinStr "\n" $links))
				"buttons" (cslice
					(cbutton "label" "Confirm promotion" "custom_id" (printf "iota_deploymentsPromotionConfirm-%d-%d" $member.User.ID $currentRank.RoleID) "style" "success")
					(cbutton "label" "Deny promotion" "custom_id" (printf "iota_deploymentsPromotionDeny-%d-%d" $member.User.ID $currentRank.RoleID) "style" "danger")
				)
			)
		)
	)}}

	{{sendMessage 1384142646536048740 $promotionContainer}}
{{end}}