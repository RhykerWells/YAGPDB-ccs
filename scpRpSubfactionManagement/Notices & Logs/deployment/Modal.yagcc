{{/*
Made by ranger_4297 (765316548516380732)

Trigger Type: `Modal`
Trigger: `\A(?i)iota_deployment`

©️ RhykerWells 2020-Present
GNU, GPLV3 License
Repository: https://github.com/RhykerWells/YAGPDB-ccs/
*/}}

{{$factionData := dbGet 0 "FactionDataV2"}}
{{if not $factionData}}
	{{sendResponse nil "FactionData not set up, please modify and run `-setData`"}}
	{{return}}
{{end}}

{{$deploymentID := reReplace `[A-z]+-` .StrippedID "" | toInt}}
{{$deployedAsRoleID := 0}}
{{if reFind `SubmitLog` .StrippedID}}
	{{$parts := split .StrippedID "-"}}
	{{$deploymentID = toInt (index $parts 1)}}
	{{$deployedAsRoleID = toInt (index $parts 2)}}
{{end}}
{{$entry := dbGet $deploymentID "deploymentData"}}
{{$db := $entry.Value}}
{{if not $db}}
	{{sendResponse nil (componentBuilder "text" "Something went wrong" "ephemeral" true)}}
	{{return}}
{{end}}

{{if reFind `Outcome` .StrippedID}}
	{{$x := sendResponseRetID nil (componentBuilder "text" "Loading..." "ephemeral" true)}}
    {{if reFind `Proof` .StrippedID}}
		{{range $_, $v := .InteractionData.Resolved.Attachments}}
			{{$url := reReplace "\u0026" $v.URL "&"}}
			{{$db.Set "Proof" $url}}
			{{break}}
		{{end}}
    {{end}}
	{{dbSetExpire $db.ID "deploymentData" $db (toInt (($entry.ExpiresAt.Sub currentTime).Seconds))}}
	{{editResponse .Interaction.Token $x (componentBuilder "text" "Done!" "ephemeral" true)}}
	{{deleteInteractionResponse .Interaction.Token $x}}
{{end}}

{{if reFind `SubmitLog` .StrippedID}}
	{{$x := sendResponseRetID nil (componentBuilder "text" "Loading..." "ephemeral" true)}}
	{{$logID := dbIncr 0 "NewDlog" 1 | toInt}}
	{{$deploymentLog := sdict
		"ID" $logID
		"Session" $db.ID
		"MsgID" 0
		"User" (sdict "ID" .User.ID "RobloxName" (reReplace ` \|.*` .Member.Nick ""))
		"Host" (sdict "ID" $db.Host.User.ID "RobloxName" (reReplace ` \|.*` $db.Host.Nick ""))
		"DeployedAs" $deployedAsRoleID
		"Duties" .ModalValues.deploymentDutiesInput.value
		"Incident" .ModalValues.deploymentIncidentInput.value
		"Proof" $db.Proof
	}}
	{{$threads := (dbGet 0 "deploymentLogThreads").Value}}
	{{if not $threads}}
		{{$threads = sdict}}
	{{end}}
	{{$logChannel := $threads.Get $deploymentLog.User.RobloxName}}
	{{if $logChannel}}
		{{openThread (toInt $logChannel)}}
	{{else}}
		{{try}}
			{{$logChannel = (createForumPost 1534690514572542092 $deploymentLog.User.RobloxName (printf "%s's deployment log" .User.Mention)).ID}}
		{{catch}}
			{{sendMessage nil (complexMessage "ephemeral" true "content" "Was not able to create a forum post channel for deployment log. Your log has not been saved.")}}
			{{return}}
		{{end}}
		{{$threads.Set $deploymentLog.User.RobloxName $logChannel}}
		{{dbSet 0 "deploymentLogThreads" $threads}}
	{{end}}
	{{$logContainer := (componentBuilder
		"allowed_mentions" (sdict "users" cslice)
		"container" (sdict
			"color" 0x4b9a4e
			"components" (componentBuilder
				"text" (printf "# Deployment Log #%d" $deploymentLog.ID)
				"separator" true
				"text" (printf "> **User**: @%s (<@%d>)\n> **Deployment Rank**: <@&%d>\n> **Deployment Host**: @%s (<@%d>)\n> **Duties**: %s\n> **Incident(s)**: %s" $deploymentLog.User.RobloxName $deploymentLog.User.ID $deploymentLog.DeployedAs $deploymentLog.Host.RobloxName $deploymentLog.Host.ID $deploymentLog.Duties $deploymentLog.Incident)
				"separator" false
				"gallery" (cslice
					(sdict "media" (or $deploymentLog.Proof "https://iota-4.org/missingProof.png"))
				)
			)
		)
	)}}
	{{$dLogID := sendMessageRetID $logChannel $logContainer}}
	{{$deploymentLog.Set "MsgID" $dLogID}}
	{{$userData := or (dbGet $deploymentLog.User.ID "deploymentData").Value (sdict "Logs" cslice "LogsByRank" dict)}}
	{{$userData.Set "Logs" ($userData.Logs.Append $deploymentLog)}}
	{{$LogsByRank := or ($userData.LogsByRank.Get $deploymentLog.DeployedAs) cslice}}
	{{$LogsByRank = $LogsByRank.Append $deploymentLog.ID}}
	{{$userData.LogsByRank.Set $deploymentLog.DeployedAs $LogsByRank}}
	{{dbSet $deploymentLog.User.ID "deploymentData" $userData}}
	{{editResponse .Interaction.Token $x (componentBuilder "text" (printf "Done!\nLog created [here](https://discord.com/channels/%d/%d/%d)" .Guild.ID $logChannel $dLogID) "ephemeral" true)}}
	{{deleteInteractionResponse .Interaction.Token $x}}
{{end}}