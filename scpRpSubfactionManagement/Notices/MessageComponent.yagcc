{{/*
		Made by ranger_4297 (765316548516380732)

	Trigger Type: `Message Component`
	Trigger: `\A(?i)iota_join`

	Defer: Ephemeral Message Response

	©️ RhykerWells 2020-Present
	GNU, GPLV3 License
	Repository: https://github.com/RhykerWells/YAGPDB-ccs/
*/}}

{{$factionData := dbGet 0 "FactionDataV2"}}
{{if not $factionData}}
	{{sendResponse "FactionData not set up, please modify and run `-setData`"}}
	{{return}}
{{end}}

{{$targetMember := .Member}}

{{/* Training button */}}
{{if reFind `Training` .StrippedID}}
	{{$x := sendResponseRetID nil (componentBuilder "text" "Loading..." "ephemeral" true)}}
	{{$trainingRole := reReplace `[A-z]+-` .StrippedID ""}}
	{{if not (hasRoleID $trainingRole)}}
		{{editResponse .Interaction.Token $x (componentBuilder "text" (printf "You cannot join this training as you are not a <@&%s>." $trainingRole) "ephemeral" true)}}
		{{deleteInteractionResponse .Interaction.Token $x}}
		{{return}}
	{{end}}
	{{$currentTraining := (dbGet .Message.ID "trainingConfirmations").Value}}
	{{if in $currentTraining.Users $targetMember.User.ID}}
		{{$newTraining := cslice}}
		{{range $currentTraining.Users}}
			{{if eq . $targetMember.User.ID}}
				{{continue}}
			{{end}}
			{{$newTraining = $newTraining.Append .}}
		{{end}}
		{{$currentTraining.Set "Users" $newTraining}}
		{{editResponse .Interaction.Token $x (componentBuilder "text" (printf "You've removed your confirmation from this training") "ephemeral" true)}}
		{{deleteInteractionResponse .Interaction.Token $x}}
	{{else}}
		{{$logs := (dbGet 0 "trainingLogs").Value}}
		{{$hasTraining := false}}
		{{range $_, $log := $logs}}
			{{if not $log}}
				{{continue}}
			{{end}}
			{{if ne $log.User.ID $targetMember.User.ID}}
				{{continue}}
			{{end}}
			{{if eq $log.Type $trainingRole}}
				{{$hasTraining = true}}
				{{break}}
			{{end}}
		{{end}}
		{{if $hasTraining}}
			{{editResponse .Interaction.Token $x (componentBuilder "text" (printf "You've already completed the training for this role.") "ephemeral" true)}}
			{{deleteInteractionResponse .Interaction.Token $x}}
			{{return}}
		{{end}}
		{{$currentTraining.Set "Users" ($currentTraining.Users.Append .User.ID)}}
		{{editResponse .Interaction.Token $x (componentBuilder "text" (printf "You've added your confirmation to this training") "ephemeral" true)}}
		{{deleteInteractionResponse .Interaction.Token $x}}
	{{end}}
	{{$notificationContainer := (componentBuilder
		"allowed_mentions" (sdict
			"roles" (cslice $currentTraining.ContainerData.Rank.RoleID)
		)
		"container" (sdict
			"color" $currentTraining.ContainerData.Color
			"components" (componentBuilder
				"text" (printf "# %s Training" $currentTraining.ContainerData.Rank.Name)
				"separator" true
				"text" (printf "> **Host**: %s\n> **Time**: <t:%d:f>\n\nPlease use the button below to confirm/unconfirm attendance **at least** 5 minutes before.\n**You do not need to attend if you have PASSED a <@&%d> training**\n\nRequires: `%d`+ confirmations.\nYou will be pinged 5 minutes before with the server name if there are sufficient confirmations." $currentTraining.ContainerData.Host $currentTraining.ContainerData.Time $currentTraining.ContainerData.Rank.RoleID $currentTraining.ContainerData.MinConfirms)
				"buttons" (cslice
					(cbutton "label" "Toggle Confirmation" "custom_id" (printf "iota_joinTraining-%d" $currentTraining.ContainerData.Rank.RoleID) "style" "success")
					(cbutton "label" (printf "Confirmed: %s" (humanizeThousands (len $currentTraining.Users))) "custom_id" "iota_confirmedTraining" "style" "secondary" "disabled" true)
				)
			)
		)
	)}}
	{{dbSetExpire .Message.ID "trainingConfirmations" $currentTraining (toInt ((dbGet .Message.ID "trainingConfirmations").ExpiresAt.Sub currentTime).Seconds)}}
	{{editMessage nil .Message.ID $notificationContainer}}
{{end}}